# Copy to server/.env and fill in. Never commit server/.env.
PORT=8787
# Optional long random string for Odoo/AI access without signing in; the app asks for it in Cloud → Odoo. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_TOKEN=
# Your app's origin when it is hosted on a different domain than this proxy (CORS). Leave empty if SERVE_STATIC=1.
ALLOWED_ORIGIN=
# 1 = also serve the app from this server (open http://localhost:8787)
SERVE_STATIC=1

# Odoo
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database
# Login (email) of the integration user — used by JSON-RPC mode
ODOO_LOGIN=
# API key of that user: Odoo → Preferences → Account Security → New API Key
ODOO_API_KEY=
# jsonrpc = Odoo 14–18 (and 19, deprecated there); json2 = Odoo 19+ JSON-2 API
ODOO_MODE=jsonrpc
# Optional comma-separated whitelist, e.g. res.partner,sale.order,account.move
ODOO_ALLOWED_MODELS=
MAX_UPLOAD_MB=25

# Assistant (optional) — any OpenAI-compatible provider; the key stays here, never in the browser
# Free / free-tier OpenAI-compatible providers (keys are personal: create your own, keep them here only, never in the app or git)
# Google AI Studio: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash            AI_VISION_MODEL=gemini-2.5-flash
# Groq:             AI_BASE_URL=https://api.groq.com/openai/v1                        AI_MODEL=llama-3.3-70b-versatile     AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter:       AI_BASE_URL=https://openrouter.ai/api/v1                           AI_MODEL=meta-llama/llama-3.3-70b-instruct:free  AI_VISION_MODEL=google/gemma-3-27b-it:free
# Mistral:          AI_BASE_URL=https://api.mistral.ai/v1                              AI_MODEL=mistral-small-latest        AI_VISION_MODEL=mistral-small-latest
# NVIDIA NIM:       AI_BASE_URL=https://integrate.api.nvidia.com/v1                    AI_MODEL=meta/llama-3.3-70b-instruct AI_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# Local (Ollama):   AI_BASE_URL=http://localhost:11434/v1  AI_API_KEY=ollama           AI_MODEL=qwen2.5:7b                  AI_VISION_MODEL=qwen2.5vl:7b
# Model names change often; check each provider's model list and free-tier terms (some free tiers may use prompts for training).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
# Optional backup provider, used automatically when the primary answers 429 (quota) or 5xx
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_VISION_MODEL=
AI_TIMEOUT_MS=120000

# Accounts (optional — the app works fully without signing in)
# Long random secret that signs sessions: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Where users.json and per-user sync backups are stored (relative to server/)
DATA_DIR=data
# 1 = print sign-in codes in the server console instead of sending them (testing only)
AUTH_DEV=0
# Email codes — Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# …or Resend instead of SMTP
RESEND_API_KEY=
# WhatsApp codes — Meta WhatsApp Cloud API with an approved AUTHENTICATION template that has one {{1}} code and a copy-code button
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=
WA_LANG=ar
WA_API_VERSION=v21.0
# Sign in with Google (Gmail accounts) — OAuth Web client ID; add your app origin to Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# ---- access to /api/odoo and /api/ai ----
# PROXY_TOKEN (above) always works. Signed-in accounts get access only when listed here (comma-separated e-mails or phones), or '*' for every account.
PROXY_USERS=
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For (rate limits use the client IP)
TRUST_PROXY=0
# Let the app choose the AI model when AI_MODEL is empty (off by default so free quotas can't be spent on other models)
AI_ALLOW_CLIENT_MODEL=0
# Folder served when SERVE_STATIC=1 (default: ../dist)
STATIC_DIR=
