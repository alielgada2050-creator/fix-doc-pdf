{
  "name": "wathiq-mobile",
  "private": true,
  "description": "Android app (Capacitor) wrapping the Wathiq web build in ../dist",
  "scripts": {
    "prepare-web": "node ../build.mjs && rm -rf www && cp -r ../dist www",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#ff8a1f' --splashBackgroundColor '#fff6e8' --splashBackgroundColorDark '#121b2e'",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/core": "6.2.3",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/share": "6.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.3"
  }
}
